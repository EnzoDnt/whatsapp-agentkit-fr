# ─── Anthropic ────────────────────────────────────────────────────────────
# https://platform.anthropic.com/settings/keys — commence par sk-ant-
ANTHROPIC_API_KEY=

# claude-opus-5      le plus capable        5 $ / 25 $ par million de tokens
# claude-sonnet-5    l'équilibré (défaut)   3 $ / 15 $
# claude-haiku-4-5   le plus rapide         1 $ / 5 $
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
# ANTHROPIC_MAX_TOKENS=4096

# ─── Fournisseur WhatsApp ─────────────────────────────────────────────────
# simulateur = local, aucun compte Meta requis (commencez par là)
# meta       = WhatsApp Cloud API en direct
WHATSAPP_PROVIDER=simulateur

# ─── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ───────────────────────────
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_ID=
# Obligatoire : sans lui les webhooks ne sont pas vérifiables.
META_APP_SECRET=
# Vous l'inventez ; l'agent le génère pour vous.
META_VERIFY_TOKEN=
META_API_VERSION=v25.0

# ─── Sécurité ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Uniquement en local, en connaissance de cause. Ignoré si ENVIRONMENT=production.
AUTORISER_WEBHOOK_NON_SIGNE=false
# Sel de hachage des numéros dans les logs. Générez-le : openssl rand -hex 24
PII_HASH_SALT=
# true = écrit le contenu des messages dans les logs. Développement SEULEMENT.
LOG_MESSAGE_CONTENT=false

# ─── Garde-fous ───────────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_FENETRE_S=3600
PLAFOND_DEPENSE_JOUR=5
MAX_TOURS_OUTILS=5
MAX_MESSAGES_HISTORIQUE=20
# Purge RGPD de l'historique (jours). 0 = jamais (déconseillé).
RETENTION_JOURS=90

# ─── Serveur et base ──────────────────────────────────────────────────────
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Production : PostgreSQL obligatoire (le disque d'un conteneur est éphémère)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/base

# ─── Back-office (optionnel) ──────────────────────────────────────────────
# Vide = back-office désactivé. Générez-le : openssl rand -hex 24
ADMIN_TOKEN=

# ─── Garde-fou de test ────────────────────────────────────────────────────
# Numéros autorisés pendant les essais, séparés par des virgules. L agent
# ignore tous les autres. Indispensable si le numéro est déjà en production.
# Vide = répond à tout le monde (comportement normal).
TEST_ALLOWLIST=

# ─── Transparence IA (AI Act art. 50, obligatoire depuis le 02/08/2026) ───
# discrete   : ligne en italique en fin du 1er message (recommandé)
# explicite  : encart en tête du 1er message
# validation : aucune réponse ne part sans relecture humaine (dispense de marquage)
MODE_TRANSPARENCE=discrete

# ─── Console d administration ─────────────────────────────────────────────
# Jeton d installation : sert UNIQUEMENT a creer le premier compte.
# Generez-le : openssl rand -hex 24
ADMIN_TOKEN=
# Signature des sessions. OBLIGATOIRE en production : openssl rand -hex 32
SESSION_SECRET=
DUREE_SESSION_HEURES=12

# ─── Moteur d intelligence ────────────────────────────────────────────────
# anthropic (defaut) | openai | openrouter | google
LLM_PROVIDER=anthropic
# Vide = modele par defaut du fournisseur choisi
LLM_MODEL=
# Par defaut selon le fournisseur : claude-sonnet-5 · gpt-5.6-terra ·
# moonshotai/kimi-k3 · gemini-3.7-flash
# Renseignez SEULEMENT la cle du fournisseur retenu
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
